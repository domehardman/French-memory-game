  <PROJECT FORMAT="1.00" NAME="Französisches Memory-Spiel" AUTHOR="Colin / Noemie Brem" CREATED="2026.09.21 15:36:01" MODIFIED="2026.09.21 16:24:21">
    <DIAGRAMS>
      <DIAGRAM FORMAT="1.00" ID="0" NAME="Hauptprogramm - Französisches Memory" CREATED="2026.09.21 15:36:01" MODIFIED="2026.09.21 16:24:21">
        <LAYOUT FORMAT="1.00" COLUMNS="5" ROWS="18">
          <ENTRIES>
            <ENTRY COLUMN="0" ROW="9">
              <FIGURE SUBTYPE="PapCondition" FORMAT="1.00" ID="161">
                <TEXT><![CDATA[Ist die Zeit- oder Zugbegrenzung erreicht?]]></TEXT>
              </FIGURE>
            </ENTRY>
            <ENTRY COLUMN="0" ROW="13">
              <FIGURE SUBTYPE="PapActivity" FORMAT="1.00" ID="211">
                <TEXT><![CDATA[Level erhöhen
Belohnung freischalten
Level-Fortschritt speichern]]></TEXT>
              </FIGURE>
            </ENTRY>
            <ENTRY COLUMN="0" ROW="14">
              <FIGURE SUBTYPE="PapCondition" FORMAT="1.00" ID="151">
                <TEXT><![CDATA[Genügend Punkte für das nächste Level?]]></TEXT>
              </FIGURE>
            </ENTRY>
            <ENTRY COLUMN="0" ROW="15">
              <FIGURE SUBTYPE="PapConnector" FORMAT="1.00" ID="174">
                <TEXT><![CDATA[]]></TEXT>
              </FIGURE>
            </ENTRY>
            <ENTRY COLUMN="1" ROW="0" ANCHOR="True">
              <FIGURE SUBTYPE="PapTitle" FORMAT="1.00" ID="0">
                <TEXT><![CDATA[Hauptprogramm - Französisches Memory]]></TEXT>
              </FIGURE>
            </ENTRY>
            <ENTRY COLUMN="1" ROW="1">
              <FIGURE SUBTYPE="PapStart" FORMAT="1.00" ID="1">
                <TEXT><![CDATA[Start]]></TEXT>
              </FIGURE>
            </ENTRY>
            <ENTRY COLUMN="1" ROW="2">
              <FIGURE SUBTYPE="PapOutput" FORMAT="1.00" ID="6">
                <TEXT><![CDATA[Hauptmenü anzeigen: Spielen, Vokabelsets, eigene Vokabeln, Statistik]]></TEXT>
              </FIGURE>
            </ENTRY>
            <ENTRY COLUMN="1" ROW="3">
              <FIGURE SUBTYPE="PapOutput" FORMAT="1.00" ID="8">
                <TEXT><![CDATA[Vokabelset und Spielmodus auswählen]]></TEXT>
              </FIGURE>
            </ENTRY>
            <ENTRY COLUMN="1" ROW="4">
              <FIGURE SUBTYPE="PapActivity" FORMAT="1.00" ID="110">
                <TEXT><![CDATA[Vorbereitete Vokabelsets, Themenbereiche, gespeicherte eigene Vokabeln, Statistiken und Spielfortschritt laden]]></TEXT>
              </FIGURE>
            </ENTRY>
            <ENTRY COLUMN="1" ROW="5">
              <FIGURE SUBTYPE="PapOutput" FORMAT="1.00" ID="112">
                <TEXT><![CDATA[Spielmodi anzeigen:
1. Vorbereitete Vokabeln
2. Eigene Vokabelpaare mit optionalen Bildern]]></TEXT>
              </FIGURE>
            </ENTRY>
            <ENTRY COLUMN="1" ROW="6">
              <FIGURE SUBTYPE="PapInput" FORMAT="1.00" ID="114">
                <TEXT><![CDATA[Eingabe: Spielmodus auswählen
Bei vorbereitetem Modus zusätzlich Themenbereich und Vokabelset auswählen]]></TEXT>
              </FIGURE>
            </ENTRY>
            <ENTRY COLUMN="1" ROW="7">
              <FIGURE SUBTYPE="PapCondition" FORMAT="1.00" ID="116">
                <TEXT><![CDATA[Wurde der Modus "Vorbereitete Vokabeln" gewählt?]]></TEXT>
              </FIGURE>
            </ENTRY>
            <ENTRY COLUMN="1" ROW="8">
              <FIGURE SUBTYPE="PapActivity" FORMAT="1.00" ID="200">
                <TEXT><![CDATA[Gewähltes oder selbst erstelltes Vokabelset übernehmen
Karten erzeugen und zufällig mischen
alle Karten verdeckt anzeigen
Versuche = 0
Treffer = 0
Gefundene Paare = 0
Punkte = 0
Timer oder Zugbegrenzung starten]]></TEXT>
              </FIGURE>
            </ENTRY>
            <ENTRY COLUMN="1" ROW="9">
              <FIGURE SUBTYPE="PapCondition" FORMAT="1.00" ID="125">
                <TEXT><![CDATA[Gibt es noch nicht gefundene Paare?]]></TEXT>
              </FIGURE>
            </ENTRY>
            <ENTRY COLUMN="1" ROW="10">
              <FIGURE SUBTYPE="PapOutput" FORMAT="1.00" ID="141">
                <TEXT><![CDATA[Verdeckte Karten, Zeit, Versuche, Treffer und Punkte anzeigen]]></TEXT>
              </FIGURE>
            </ENTRY>
            <ENTRY COLUMN="1" ROW="11">
              <FIGURE SUBTYPE="PapInput" FORMAT="1.00" ID="143">
                <TEXT><![CDATA[Erste und zweite Karte anklicken und aufdecken]]></TEXT>
              </FIGURE>
            </ENTRY>
            <ENTRY COLUMN="1" ROW="12">
              <FIGURE SUBTYPE="PapCondition" FORMAT="1.00" ID="145">
                <TEXT><![CDATA[Passen französisches Wort und deutsche Übersetzung zusammen?]]></TEXT>
              </FIGURE>
            </ENTRY>
            <ENTRY COLUMN="1" ROW="13">
              <FIGURE SUBTYPE="PapOutput" FORMAT="1.00" ID="147">
                <TEXT><![CDATA[Richtig: Karten als gefunden markieren und Belohnung anzeigen]]></TEXT>
              </FIGURE>
            </ENTRY>
            <ENTRY COLUMN="1" ROW="14">
              <FIGURE SUBTYPE="PapActivity" FORMAT="1.00" ID="149">
                <TEXT><![CDATA[Gefundene Paare = Gefundene Paare + 1
Treffer = Treffer + 1
Punkte erhöhen
Fortschritt speichern]]></TEXT>
              </FIGURE>
            </ENTRY>
            <ENTRY COLUMN="1" ROW="16">
              <FIGURE SUBTYPE="PapOutput" FORMAT="1.00" ID="78">
                <TEXT><![CDATA[Runde beendet.
Bei allen gefundenen Paaren: Félicitations!
Sonst: Zeit- oder Zugbegrenzung erreicht.
Zeit, Versuche, Treffer, Punkte, Belohnungen und Level anzeigen
Statistik und Spielfortschritt speichern]]></TEXT>
              </FIGURE>
            </ENTRY>
            <ENTRY COLUMN="1" ROW="17">
              <FIGURE SUBTYPE="PapEnd" FORMAT="1.00" ID="2">
                <TEXT><![CDATA[Ende]]></TEXT>
              </FIGURE>
            </ENTRY>
            <ENTRY COLUMN="2" ROW="12">
              <FIGURE SUBTYPE="PapCondition" FORMAT="1.00" ID="166">
                <TEXT><![CDATA[Wurden zwei verschiedene, noch verdeckte Karten gewählt?]]></TEXT>
              </FIGURE>
            </ENTRY>
            <ENTRY COLUMN="2" ROW="13">
              <FIGURE SUBTYPE="PapOutput" FORMAT="1.00" ID="177">
                <TEXT><![CDATA[Falsch: kurz warten und beide Karten wieder verdecken]]></TEXT>
              </FIGURE>
            </ENTRY>
            <ENTRY COLUMN="2" ROW="14">
              <FIGURE SUBTYPE="PapActivity" FORMAT="1.00" ID="179">
                <TEXT><![CDATA[Versuche = Versuche + 1
Trefferquote und Statistik aktualisieren]]></TEXT>
              </FIGURE>
            </ENTRY>
            <ENTRY COLUMN="2" ROW="15">
              <FIGURE SUBTYPE="PapConnector" FORMAT="1.00" ID="181">
                <TEXT><![CDATA[]]></TEXT>
              </FIGURE>
            </ENTRY>
            <ENTRY COLUMN="3" ROW="12">
              <FIGURE SUBTYPE="PapConnector" FORMAT="1.00" ID="164">
                <TEXT><![CDATA[]]></TEXT>
              </FIGURE>
            </ENTRY>
            <ENTRY COLUMN="3" ROW="13">
              <FIGURE SUBTYPE="PapOutput" FORMAT="1.00" ID="168">
                <TEXT><![CDATA[Ungültige Kartenauswahl ignorieren und erneut auswählen]]></TEXT>
              </FIGURE>
            </ENTRY>
            <ENTRY COLUMN="3" ROW="15">
              <FIGURE SUBTYPE="PapConnector" FORMAT="1.00" ID="171">
                <TEXT><![CDATA[]]></TEXT>
              </FIGURE>
            </ENTRY>
            <ENTRY COLUMN="4" ROW="7">
              <FIGURE SUBTYPE="PapInput" FORMAT="1.00" ID="118">
                <TEXT><![CDATA[Ein oder mehrere eigene Vokabelpaare eingeben:
französisches Wort
deutsche Übersetzung
optional ein Bild auswählen]]></TEXT>
              </FIGURE>
            </ENTRY>
            <ENTRY COLUMN="4" ROW="8">
              <FIGURE SUBTYPE="PapActivity" FORMAT="1.00" ID="122">
                <TEXT><![CDATA[Eigene Wortpaare und Bilder prüfen und als eigenes Vokabelset speichern]]></TEXT>
              </FIGURE>
            </ENTRY>
            <ENTRY COLUMN="4" ROW="9">
              <FIGURE SUBTYPE="PapConnector" FORMAT="1.00" ID="127">
                <TEXT><![CDATA[]]></TEXT>
              </FIGURE>
            </ENTRY>
            <ENTRY COLUMN="4" ROW="16">
              <FIGURE SUBTYPE="PapConnector" FORMAT="1.00" ID="138">
                <TEXT><![CDATA[]]></TEXT>
              </FIGURE>
            </ENTRY>
          </ENTRIES>
        </LAYOUT>
